# ==============================================================================
# FIXAR SERVICE — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env.local for local development, or configure in hosting provider
# ==============================================================================

# Application Base URL (Required for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=https://www.fixar.in

# Cryptographic Session & JWT Secret (Generate with: openssl rand -base64 32)
# NEVER commit the real secret to version control
AUTH_SECRET=fixar_production_secure_token_secret_replace_in_prod_2026

# PostgreSQL / Supabase Database Connection
# Used by production migrations and relational database adapter
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[YOUR-SERVICE-ROLE-KEY]

# Initial First-Admin Bootstrap (Applied on first boot if no admin exists)
# Admin credentials can be updated after initial login from Admin Settings
ADMIN_EMAIL=fixarservices@gmail.com
ADMIN_USER=fixarservices@gmail.com
ADMIN_PASSWORD=FixarServices@2026@

# Optional Abuse Prevention & Spam Protection (Cloudflare Turnstile)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Notification Webhooks (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# WHATSAPP_BUSINESS_API_TOKEN=...
